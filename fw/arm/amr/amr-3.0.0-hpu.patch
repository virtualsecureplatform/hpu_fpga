diff --git a/fw/AMC/src/osal/src/freeRTOS/osal.c b/fw/AMC/src/osal/src/freeRTOS/osal.c
index 2874cd0..04a5d6d 100755
--- a/fw/AMC/src/osal/src/freeRTOS/osal.c
+++ b/fw/AMC/src/osal/src/freeRTOS/osal.c
@@ -86,6 +86,45 @@ static void *pvStrNCpySemHandle   = NULL;
 static void *pvMemCmpSemHandle    = NULL;
 static void *pvMemMoveSemHandle   = NULL;
 
+#ifdef AMC_COPY_DIAG
+/* First failures survive later activity. No allocation, copying or logging here.
+ * R5-local IRQ masking protects records from task/IRQ interleaving. */
+static volatile struct {
+    uint32_t count;
+    struct { uintptr_t caller, destination, source; uint32_t size; } first[16];
+} xCopyDiag;
+
+static void vRecordCopyFailure( uintptr_t caller, void *destination,
+                                const void *source, uint32_t size )
+{
+    uint32_t saved;
+    __asm__ volatile ( "mrs %0, cpsr\n\tcpsid i" : "=r" (saved) :: "memory" );
+    uint32_t index = xCopyDiag.count;
+    if( index < 16 )
+    {
+        xCopyDiag.first[index].caller = caller;
+        xCopyDiag.first[index].destination = (uintptr_t)destination;
+        xCopyDiag.first[index].source = (uintptr_t)source;
+        xCopyDiag.first[index].size = size;
+    }
+    if( index != UINT32_MAX ) xCopyDiag.count = index + 1;
+    __asm__ volatile ( "msr cpsr_c, %0" :: "r" (saved) : "memory" );
+}
+
+void vOSAL_PrintCopyDiagnostics( void )
+{
+    uint32_t count = xCopyDiag.count;
+    vOSAL_Printf( "COPY_DIAG failed_acquisitions=%u retained=%u\r\n",
+                 (unsigned)count, (unsigned)(count < 16 ? count : 16) );
+    for( uint32_t i = 0; i < count && i < 16; ++i )
+        vOSAL_Printf( "COPY_DIAG n=%u caller=%08x dst=%08x src=%08x size=%u\r\n",
+                     (unsigned)i, (unsigned)xCopyDiag.first[i].caller,
+                     (unsigned)xCopyDiag.first[i].destination,
+                     (unsigned)xCopyDiag.first[i].source,
+                     (unsigned)xCopyDiag.first[i].size );
+}
+#endif
